# Keep the patch files LF: `git apply` rejects a patch whose context lines carry CRLF.
*.patch text eol=lf
*.sh text eol=lf
*.rs  text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf

# PowerShell and the Windows-only bits are happiest with CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
