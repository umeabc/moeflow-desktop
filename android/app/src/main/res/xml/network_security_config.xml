<?xml version="1.0" encoding="utf-8"?>
<!-- 允许明文 HTTP 流量：内网部署形态可能是 http://172.29.133.24
     这是已知的安全权衡，用于支持内网自托管场景 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
