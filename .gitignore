# Build output — regenerated by `npm run build` / `cargo build`.
/node_modules/
/build/
/src-tauri/target/

# The upstream frontend is *vendored*, not owned: `scripts/fetch-frontend.sh` clones
# moeflow-com/moeflow at a pinned commit and the patches in `patches/` are applied on top.
# Committing it would re-host someone else's repository and add ~430 MB for no benefit.
/frontend/

# Per-machine state.
*.log
.env
.env.local

# Tauri regenerates these on every build.
/src-tauri/gen/schemas/
