{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the MoeFlow shell windows.",
  "windows": ["main", "launcher"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:default",
    "dialog:default",
    "dialog:allow-save",
    "opener:default",
    "opener:allow-open-url",
    "window-state:default",
    "core:path:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "default"
  ]
}
